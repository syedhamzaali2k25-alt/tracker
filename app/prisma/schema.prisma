// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Last diagnostic result per shop, so "Create sheet" can reuse it instead of
// re-fetching from Shopify or round-tripping rows through the browser.
// Replaces an earlier in-memory Map (lost on restart, not shared across
// instances) now that real per-shop storage exists for OAuth sessions.
model DiagnosticCache {
  shop      String   @id
  // JSON-serialized { rows: MarginRow[], summary: DiagnosticSummary }
  data      String
  updatedAt DateTime @updatedAt
}

// Per-shop Google connection: an encrypted OAuth refresh token (per-merchant
// consent, replacing the old single shared service account) plus the ID of
// the spreadsheet the app created in that merchant's own Drive the first
// time they created a sheet. refreshToken is nullable so a revoked/expired
// grant can be cleared without losing the spreadsheetId link — reconnecting
// resumes writing to the same sheet instead of creating a new one.
model GoogleAccount {
  shop          String   @id
  refreshToken  String?
  spreadsheetId String?
  updatedAt     DateTime @updatedAt
}

// One row per applyChanges() run: the before-values for every variant it
// touched, so History can undo a specific push later. Replaces the old
// filesystem snapshots in ./backups/ — a database row survives across
// machines/deploys the way a local JSON file never could, and lets the
// dashboard list past pushes instead of only ever restoring "the latest".
model PushBatch {
  id          String    @id @default(cuid())
  shop        String
  createdAt   DateTime  @default(now())
  changeCount Int
  // JSON-serialized BackupEntry[] — the price/cost each touched variant had
  // right before this push.
  entries     String
  reverted    Boolean   @default(false)
  revertedAt  DateTime?

  @@index([shop, createdAt])
}

// Per-shop weekly-email preferences. alertEmail is an optional override —
// null means "use the shop's own Shopify account email" (see
// app/app/routes/app.settings.tsx and app/cron/weeklyCheck.server.ts).
model ShopSettings {
  shop        String   @id
  emailAlerts Boolean  @default(true)
  alertEmail  String?
  updatedAt   DateTime @updatedAt
}

// The weekly watchman job's own last-run snapshot per shop, kept separate
// from DiagnosticCache (which reflects the merchant's own ad-hoc "Sync"
// clicks in the dashboard) so the week-over-week diff has a stable,
// job-owned baseline instead of being skewed by whatever the merchant
// happened to sync most recently.
model WatchmanRun {
  shop  String   @id
  // JSON-serialized { rows: MarginRow[], summary: DiagnosticSummary }
  data  String
  ranAt DateTime @updatedAt
}

// Per-shop billing state for the paid "Push changes" gate. This is a
// read-optimized mirror of Shopify's own AppSubscription, not the source of
// truth (Shopify is). It's kept in sync two ways: the billing confirmation
// redirect (app/routes/app.billing.callback.tsx) writes it right after a
// merchant approves or declines, and the APP_SUBSCRIPTIONS_UPDATE webhook
// (app/routes/webhooks.app_subscriptions.update.tsx) writes it for every
// change Shopify makes on its own — most importantly a merchant cancelling
// from inside Shopify admin, which never touches our app at all otherwise.
// status mirrors AppSubscription.status verbatim (ACTIVE, CANCELLED,
// DECLINED, EXPIRED, FROZEN, PENDING) rather than being pre-collapsed into
// a boolean, so the dashboard can show the merchant what actually happened
// instead of just "not subscribed".
model Subscription {
  shop                  String    @id
  shopifySubscriptionId String?
  status                String
  isTest                Boolean   @default(false)
  trialEndsAt           DateTime?
  currentPeriodEnd      DateTime?
  updatedAt             DateTime  @updatedAt
}
