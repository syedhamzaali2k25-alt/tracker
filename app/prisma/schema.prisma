// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Last diagnostic result per shop, so "Create sheet" can reuse it instead of
// re-fetching from Shopify or round-tripping rows through the browser.
// Replaces an earlier in-memory Map (lost on restart, not shared across
// instances) now that real per-shop storage exists for OAuth sessions.
model DiagnosticCache {
  shop      String   @id
  // JSON-serialized { rows: MarginRow[], summary: DiagnosticSummary }
  data      String
  updatedAt DateTime @updatedAt
}

// Per-shop Google connection: an encrypted OAuth refresh token (per-merchant
// consent, replacing the old single shared service account) plus the ID of
// the spreadsheet the app created in that merchant's own Drive the first
// time they created a sheet. refreshToken is nullable so a revoked/expired
// grant can be cleared without losing the spreadsheetId link — reconnecting
// resumes writing to the same sheet instead of creating a new one.
model GoogleAccount {
  shop          String   @id
  refreshToken  String?
  spreadsheetId String?
  updatedAt     DateTime @updatedAt
}

// One row per applyChanges() run: the before-values for every variant it
// touched, so History can undo a specific push later. Replaces the old
// filesystem snapshots in ./backups/ — a database row survives across
// machines/deploys the way a local JSON file never could, and lets the
// dashboard list past pushes instead of only ever restoring "the latest".
model PushBatch {
  id          String    @id @default(cuid())
  shop        String
  createdAt   DateTime  @default(now())
  changeCount Int
  // JSON-serialized BackupEntry[] — the price/cost each touched variant had
  // right before this push.
  entries     String
  reverted    Boolean   @default(false)
  revertedAt  DateTime?

  @@index([shop, createdAt])
}
