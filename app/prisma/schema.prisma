// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Last diagnostic result per shop, so "Create sheet" can reuse it instead of
// re-fetching from Shopify or round-tripping rows through the browser.
// Replaces an earlier in-memory Map (lost on restart, not shared across
// instances) now that real per-shop storage exists for OAuth sessions.
model DiagnosticCache {
  shop      String   @id
  // JSON-serialized { rows: MarginRow[], summary: DiagnosticSummary }
  data      String
  updatedAt DateTime @updatedAt
}

// Per-shop Google connection: an encrypted OAuth refresh token (per-merchant
// consent, replacing the old single shared service account) plus the ID of
// the spreadsheet the app created in that merchant's own Drive the first
// time they created a sheet. refreshToken is nullable so a revoked/expired
// grant can be cleared without losing the spreadsheetId link — reconnecting
// resumes writing to the same sheet instead of creating a new one.
model GoogleAccount {
  shop          String   @id
  refreshToken  String?
  spreadsheetId String?
  updatedAt     DateTime @updatedAt
}

// One row per applyChanges() run, written before any Shopify writes happen
// so a failed apply still leaves a durable record of what was about to
// change. Replaces the old ./backups/*.json files — history now lives here,
// per shop, instead of on whatever machine happened to run the apply.
model PushBatch {
  id          String   @id @default(cuid())
  shop        String
  createdAt   DateTime @default(now())
  changeCount Int
  // JSON-serialized PushBatchEntry[] (src/types.ts) — the before-values for
  // every variant this batch touched, needed to undo it.
  entries     String
  // Set once this batch has been undone, so it can't be applied a second
  // time. Undoing writes new price/cost values of its own — there's nothing
  // to "re-revert" to after that.
  reverted    Boolean  @default(false)

  @@index([shop, createdAt])
}
