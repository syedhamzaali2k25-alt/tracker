# Local dev only — never read in production (no dotenv there; the host
# injects real env vars instead). See README.md's "Environment variables"
# table for what each of these is for and where required ones come from.

# Postgres connection string. For local dev:
#   docker run --name margin-tracker-db -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=margin_tracker -p 5432:5432 -d postgres:16
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/margin_tracker"

# From shopify.app.toml's client_id / the Partner Dashboard's app credentials.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# During `shopify app dev` this gets overwritten with the CLI's tunnel URL
# automatically — set it explicitly only for a non-tunneled/deployed run.
SHOPIFY_APP_URL=

# 64 hex chars (32 bytes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_ENCRYPTION_KEY=

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (Web application). Add ${SHOPIFY_APP_URL}/auth/google/callback as an
# authorized redirect URI on that client.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Only needed to run `npm run cron:weekly-check` locally — the web app
# never sends email. SendGrid > Settings > API Keys (Restricted Access,
# Mail Send only) for the key; SendGrid > Settings > Sender Authentication
# > Single Sender Verification for the from address (no domain needed).
# SENDGRID_API_KEY=
# EMAIL_FROM=

# Everything below is optional and has a default — see the README table.
# SHOP_CUSTOM_DOMAIN=
# SHOPIFY_API_VERSION=2026-07
# LOOKBACK_DAYS=30
# LOW_MARGIN_THRESHOLD=0.20
