# This project no longer uses a single Shopify shop/token here — the app
# (in app/) authenticates each shop via OAuth instead (see app/app/shopify.server.ts).
# SHOPIFY_API_VERSION is not shop-specific or secret, so it stays.
SHOPIFY_API_VERSION=2026-07

# The CLI scripts (npm run diagnostic/preview/apply/undo) are a separate,
# dev-only path that still needs a single store to test against directly —
# uncomment these and set them if you want to use the CLI locally. Create a
# custom app in your dev store (Settings > Apps and sales channels > Develop
# apps) with read_products, read_orders, read_inventory, write_products,
# write_inventory scopes, install it, and copy its access token.
# SHOPIFY_SHOP=your-store.myshopify.com
# SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Sheets access is per-merchant OAuth now, connected through the app
# (see app/README or app/.env.example for GOOGLE_OAUTH_CLIENT_ID/SECRET) —
# there's no service account or shared sheet ID to configure here anymore.

# How many days of order history to aggregate "units sold" over.
LOOKBACK_DAYS=30

# Margin % below which a product is flagged red in the diagnostic.
LOW_MARGIN_THRESHOLD=0.20
