# Shopify — create a custom app in the dev store (Admin > Settings > Apps and
# sales channels > Develop apps) with read_products, read_orders,
# read_inventory, write_products, write_inventory scopes.
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-10

# Google — create a service account in Google Cloud, enable the Sheets API,
# then share the target Sheet with the service account's email (Editor access).
GOOGLE_SERVICE_ACCOUNT_EMAIL=margin-tracker@your-project.iam.gserviceaccount.com
# Paste the private key from the downloaded JSON credentials, keeping \n escapes.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxx\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your-google-sheet-id-from-the-url

# How many days of order history to aggregate "units sold" over.
LOOKBACK_DAYS=30

# Margin % below which a product is flagged red in the diagnostic.
LOW_MARGIN_THRESHOLD=0.20
